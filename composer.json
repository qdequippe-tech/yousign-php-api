{
    "name": "qdequippe/yousign-php-api",
    "description": "PHP Yousign Client",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Quentin Dequippe",
            "email": "quentin@dequippe.tech"
        }
    ],
    "autoload": {
        "psr-4": {
            "Qdequippe\\Yousign\\Api\\": "generated/"
        }
    },
    "require": {
        "php": ">= 8.2",
        "jane-php/open-api-runtime": "^7.6"
    },
    "require-dev": {
        "jane-php/open-api-3": "^7.6"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true"
        }
    },
    "scripts": {
        "generate": "jane open-api generate --config-file=jane-config.php",
        "cs": "tools/bin/php-cs-fixer fix",
        "rector": "tools/bin/rector",
        "jane": "jane-openapi generate --config-file=.jane-openapi.php",
        "build": [
            "@jane",
            "@rector",
            "@cs"
        ]
    },
    "scripts-descriptions": {
        "cs": "Fix code style",
        "rector": "Run Rector",
        "jane": "Generate the SDK",
        "build": "Generate the SDK, then run Rector and fix code style"
    }
}
